# BUFF163 Price Checker - example environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ----- Storage backend selector -----
# Valid values: sheets (default) | sqlite | postgres
# Default preserves existing Google Sheets behavior.
STORAGE_BACKEND=sheets

# ----- PostgreSQL (required only when STORAGE_BACKEND=postgres) -----
# Never commit a real value. Store in AWS Secrets Manager, SSM, or GitHub Secrets.
DATABASE_URL=

# ----- Secrets (placeholders only - never commit real values) -----
# Local dev: set the plain env var. AWS Lambda: set <NAME>_SECRET_ARN instead
# and the app resolves it from Secrets Manager at runtime (see docs/aws-secrets.md).
# BUFF163 session cookie (avoids 403). Local: BUFF_COOKIE=... ; Lambda: BUFF_COOKIE_SECRET_ARN=...
BUFF_COOKIE=
# DATABASE_URL_SECRET_ARN=
# BUFF_COOKIE_SECRET_ARN=
# Google service-account JSON (only if STORAGE_BACKEND=sheets), as one-line JSON.
# GSHEET_CREDS_JSON=
# Discord webhook (only if alerts are later enabled). Never logged.
# DISCORD_WEBHOOK_URL=

# ----- SQLite local mode (used when STORAGE_BACKEND=sqlite) -----
BUFF_SQLITE_PATH=buff163.sqlite3

# ----- Google Sheets (used when STORAGE_BACKEND=sheets) -----
# Target spreadsheet name (must be shared with the service account email).
BUFF_SHEET_NAME=BuffKnifeTracker

# ----- HTTP reliability (scraper request behavior) -----
# Per-request timeout in seconds.
BUFF_REQUEST_TIMEOUT=15
# Extra retry attempts after the first try (transient errors only:
# timeout, connection error, HTTP 429/500/502/503/504). 0 disables retries.
BUFF_MAX_RETRIES=3
# Base seconds for exponential backoff with full jitter between retries.
BUFF_BACKOFF_BASE_SECONDS=1
# Optional local HTTP cache for dev/test only. Disabled by default.
# Never enable in CI/cloud; never cache auth/cookie responses. (Not yet
# implemented - reserved; see docs/scraper-cloud-readiness.md.)
BUFF_HTTP_CACHE_ENABLED=false

# ----- Seed goods ids (optional) -----
# Comma-separated goods_id values to seed discovery. Blank entries ignored.
# BUFF_SEED_GOODS_IDS=42552,42533,42555,42587,42998,83578
